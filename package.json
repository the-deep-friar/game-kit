{
  "name": "game-kit",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "build": "npm run build --workspaces",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/packages/*/src/**/*.test.ts"
    ]
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "expo": "~57.0.30",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "react": "^19.2.3",
    "react-native": "^0.86.3",
    "typescript": "~6.0.3"
  }
}
